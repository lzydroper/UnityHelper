# Copy this file to .env, then fill in the real Dify endpoint and keys.
# Do not commit FrontEnd/.env.

OPEN_WEBUI_PORT=3000
WEBUI_URL=http://localhost:3000
WEBUI_NAME=Unity Development Assistant
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.9.5

# Generate a stable secret before first startup, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=replace-with-a-stable-random-secret

# Use the OpenAI Compatible Dify App endpoint base URL.
# Keep the app endpoint only, for example:
# https://dify.example.com/e/replace-with-endpoint-hash
# Do not append /chat/completions here.
DIFY_OPENAI_BASE_URL=https://dify.example.com/e/replace-with-endpoint-hash
DIFY_OPENAI_API_KEY=replace-with-dify-openai-compatible-api-key

# Dify's OpenAI-compatible plugin ignores the model field, but Open WebUI
# needs a visible model id when /models is not supported.
DIFY_MODEL_ID=unity-rag-assistant
